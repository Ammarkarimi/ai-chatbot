# ---------- Core ----------
# Postgres with the pgvector extension (Supabase, Neon, RDS, or self-hosted)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/chatbot
# Public URL of this app (used in embed snippets and Stripe redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=BotForge
# Random 32+ char strings. Generate with: openssl rand -base64 32
AUTH_SECRET=change-me-to-a-long-random-string
# Encrypts customers' own API keys at rest. Changing it makes stored keys unreadable.
ENCRYPTION_KEY=change-me-to-another-long-random-string

# ---------- AI providers (platform keys) ----------
# Gemini is required: it creates all embeddings. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Groq is optional: fast chat answers with open models. https://console.groq.com/keys
GROQ_API_KEY=
# Defaults used when a bot doesn't pick a model
GEMINI_CHAT_MODEL=gemini-3.5-flash
GROQ_CHAT_MODEL=openai/gpt-oss-120b
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# ---------- Stripe (optional; billing is disabled when unset) ----------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=

# ---------- Email via Resend (verification + password reset) ----------
# 1. API key: https://resend.com/api-keys (starts with re_)
# 2. Verify your domain at https://resend.com/domains, then send from an address on it.
#    For a quick test you can use "BotForge <onboarding@resend.dev>", but Resend then only
#    delivers to the email address of your own Resend account.
# Check your setup with: npm run email:test -- you@example.com
# Without these, emails are printed to the server log, so nobody can verify in production.
RESEND_API_KEY=
EMAIL_FROM="BotForge <no-reply@yourdomain.com>"
# Optional: where replies to these emails go
EMAIL_REPLY_TO=

# ---------- Storage for large uploads (pick ONE, optional) ----------
# Option A (recommended on Vercel): a PRIVATE Vercel Blob store.
#   Vercel dashboard -> your project -> Storage -> Create -> Blob -> access: Private.
#   Vercel adds BLOB_READ_WRITE_TOKEN to the project; copy it here for local development.
BLOB_READ_WRITE_TOKEN=

# Option B (any host): an S3-compatible bucket: Cloudflare R2, AWS S3, Supabase Storage, MinIO.
# Browsers upload files straight to the bucket (no 4.5 MB serverless limit).
# R2 example endpoint: https://<account-id>.r2.cloudflarestorage.com   AWS: https://s3.<region>.amazonaws.com
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Set to true for bucket-in-hostname URLs (https://bucket.s3.amazonaws.com) instead of path-style.
S3_VIRTUAL_HOSTED=false

# ---------- Self-hosting only ----------
# Header that carries the visitor's real IP (used for rate limits). Leave unset on Vercel.
# Behind Cloudflare: cf-connecting-ip. Behind nginx/Caddy: the header your proxy sets, e.g. x-real-ip.
CLIENT_IP_HEADER=
