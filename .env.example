# ---------- Core ----------
# Postgres with the pgvector extension (Supabase, Neon, RDS, or self-hosted)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/chatbot
# Public URL of this app (used in embed snippets and Stripe redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=BotForge
# Random 32+ char strings. Generate with: openssl rand -base64 32
AUTH_SECRET=change-me-to-a-long-random-string
# Encrypts customers' own API keys at rest. Changing it makes stored keys unreadable.
ENCRYPTION_KEY=change-me-to-another-long-random-string

# ---------- AI providers (platform keys) ----------
# Gemini is required: it creates all embeddings. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Groq is optional: fast chat answers with open models. https://console.groq.com/keys
GROQ_API_KEY=
# Defaults used when a bot doesn't pick a model
GEMINI_CHAT_MODEL=gemini-3.5-flash
GROQ_CHAT_MODEL=openai/gpt-oss-120b
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# ---------- Stripe (optional; billing is disabled when unset) ----------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=

# ---------- Email (verification + password reset) ----------
# Resend API key (https://resend.com/api-keys) and a sender on a domain you verified there.
# Without these, emails are printed to the server log, so nobody can verify in production.
RESEND_API_KEY=
EMAIL_FROM="BotForge <no-reply@yourdomain.com>"

# ---------- Object storage for large uploads (optional) ----------
# Any S3-compatible bucket: Cloudflare R2, AWS S3, Supabase Storage, MinIO.
# When set, browsers upload files straight to the bucket (no 4.5 MB serverless limit).
# R2 example endpoint: https://<account-id>.r2.cloudflarestorage.com   AWS: https://s3.<region>.amazonaws.com
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Set to true for bucket-in-hostname URLs (https://bucket.s3.amazonaws.com) instead of path-style.
S3_VIRTUAL_HOSTED=false
